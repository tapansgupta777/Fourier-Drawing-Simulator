<canvas id="off" style="display:none;position:fixed;left:-9999px;top:-9999px"></canvas>

<script>
'use strict';
const DPR=window.devicePixelRatio||1;
const iCv=document.getElementById('iCv'),fCv=document.getElementById('fCv');
const offC=document.getElementById('off');
const iCtx=iCv.getContext('2d'),fCtx=fCv.getContext('2d'),offX=offC.getContext('2d');
const wrap=document.getElementById('cwrap');
const LW=()=>fCv.width/DPR,LH=()=>fCv.height/DPR;

function resize(){const w=wrap.clientWidth,h=wrap.clientHeight;if(!w||!h)return;for(const cv of[iCv,fCv]){cv.width=w*DPR;cv.height=h*DPR;cv.style.width=w+'px';cv.style.height=h+'px';}}
let _rt;new ResizeObserver(()=>{clearTimeout(_rt);_rt=setTimeout(resize,40);}).observe(wrap);
setTimeout(resize,60);

function clr(ctx){ctx.setTransform(1,0,0,1,0,0);ctx.clearRect(0,0,ctx.canvas.width,ctx.canvas.height);}
function apV(ctx){ctx.setTransform(DPR*V.sc,0,0,DPR*V.sc,DPR*V.tx,DPR*V.ty);}

const V={tx:0,ty:0,sc:1};
function zAt(mx,my,f){const wx=(mx-V.tx)/V.sc,wy=(my-V.ty)/V.sc;V.sc=Math.max(.06,Math.min(200,V.sc*f));V.tx=mx-wx*V.sc;V.ty=my-wy*V.sc;syncZ();}
function zStep(f){zAt(LW()/2,LH()/2,f);}
function resetV(){V.tx=0;V.ty=0;V.sc=1;syncZ();}
function syncZ(){document.getElementById('zlbl').textContent=Math.round(V.sc*100)+'%';document.getElementById('iZoom').textContent=V.sc.toFixed(2)+'×';}
wrap.addEventListener('wheel',e=>{e.preventDefault();const r=fCv.getBoundingClientRect();zAt(e.clientX-r.left,e.clientY-r.top,e.deltaY<0?1.1:1/1.1);},{passive:false});
let panning=false,pL={x:0,y:0};
wrap.addEventListener('mousedown',e=>{if((S.running||S.paused)&&document.getElementById('followSel').value==='off'){panning=true;pL={x:e.clientX,y:e.clientY};wrap.classList.add('panning');}});
window.addEventListener('mousemove',e=>{if(!panning)return;V.tx+=e.clientX-pL.x;V.ty+=e.clientY-pL.y;pL={x:e.clientX,y:e.clientY};syncZ();});
window.addEventListener('mouseup',()=>{panning=false;wrap.classList.remove('panning');});
let pinD=0;
wrap.addEventListener('touchstart',e=>{if(e.touches.length===2){e.preventDefault();pinD=tDst(e.touches);}},{passive:false});
wrap.addEventListener('touchmove',e=>{if(e.touches.length===2&&pinD>0){e.preventDefault();const d=tDst(e.touches),r=fCv.getBoundingClientRect();zAt((e.touches[0].clientX+e.touches[1].clientX)/2-r.left,(e.touches[0].clientY+e.touches[1].clientY)/2-r.top,d/pinD);pinD=d;}},{passive:false});
function tDst(t){return Math.hypot(t[0].clientX-t[1].clientX,t[0].clientY-t[1].clientY);}

/* Dark mode = exact colour inversion of light mode */
const PAL={
  light:{c:'#1c3878',a:'#7a4c14',t:'#78122a'},
  dark: {c:'#e3c787',a:'#85b3eb',t:'#87ebd7'}
};
function toggleTheme(){
  const r=document.documentElement,dk=r.dataset.theme==='dark';
  r.dataset.theme=dk?'light':'dark';
  document.getElementById('thBtn').textContent=dk?'🌙':'☀';
  const p=PAL[r.dataset.theme];
  document.getElementById('cC').value=p.c;document.getElementById('cA').value=p.a;document.getElementById('cT').value=p.t;
}
function toggleSB(){document.getElementById('app').classList.toggle('sb-off');}
function updateFontPrev(){const sel=document.getElementById('fontSel'),fam=sel.value,raw=sel.options[sel.selectedIndex].text.replace(' ✦','').replace(/ \(.*\)/,''),prev=document.getElementById('fontPrev');prev.style.fontFamily=fam;prev.textContent=raw;}
updateFontPrev();

const FSIZES=[512,1024,2048,4096];
function onFftRes(){const v=FSIZES[+document.getElementById('sFR').value];document.getElementById('vFR').textContent=v+' pts';document.getElementById('sE').max=v;document.getElementById('sFE').max=v;document.getElementById('nFE').max=v;}
onFftRes();
function getSpd(){return Math.pow(10,-4+document.getElementById('sSp').value*.05);}
function syncSpd(){const v=getSpd();const s=v<.001?v.toExponential(1):v<.1?v.toFixed(4):v<1?v.toFixed(3):v.toFixed(2);document.getElementById('vSp').textContent=s+'×';}
syncSpd();
function autoTrail(){if(!S.fftN)return;const spd=getSpd(),ppc=Math.min(100000,Math.max(2000,Math.round(S.fftN/Math.min(1,spd))));document.getElementById('sTl').value=ppc;document.getElementById('vTl').textContent=ppc;}
function syncFE(from){const mx=+document.getElementById('sFE').max;if(from==='r'){document.getElementById('nFE').value=document.getElementById('sFE').value;}else{const v=Math.max(1,Math.min(mx,+document.getElementById('nFE').value||1));document.getElementById('sFE').value=v;document.getElementById('nFE').value=v;}}
function adjFE(d){const cur=+document.getElementById('sFE').value,mx=+document.getElementById('sFE').max,v=Math.max(1,Math.min(mx,cur+d));document.getElementById('sFE').value=v;document.getElementById('nFE').value=v;}

/* Cycle seek with trail pre-population — Fix #3 */
function seekCycle(pct){
  if(!S.running&&!S.paused)return;
  const targetFrac=parseFloat(pct)/100;
  const targetTime=targetFrac*2*Math.PI;
  
  // Pre-populate trail from 0 to targetTime using fast approximation
  S.trail=[];
  const nEpc=Math.min(+document.getElementById('sE').value,S.fourier.length);
  const maxTr=+document.getElementById('sTl').value;
  
  if(targetTime>0&&S.fourier.length>0){
    // Use at most 4000 samples for performance; fast tip uses top ~500 components
    const numSamples=Math.min(4000,maxTr);
    const step=targetTime/numSamples;
    for(let t=step;t<=targetTime;t+=step){
      const cf=t/(2*Math.PI);
      const inGap=S.gaps.some(g=>cf>=g.s-.002&&cf<=g.e+.002);
      const inRet=S.isOpen&&cf>=S.trailCutoff;
      if(!inGap&&!inRet){
        const tip=computeTipFast(nEpc,t); // Fast: top 400 components max
        S.trail.push({x:tip.x,y:tip.y,cf});
      }
    }
  }
  
  S.time=targetTime;S.lastRafTime=0;
  document.getElementById('vCycPct').textContent=Math.round(pct)+'%';
  document.getElementById('sCyc').value=pct;
}

function adjCycle(delta){
  const cur=(S.time/(2*Math.PI))*100;
  const np=Math.max(0,Math.min(99.9,cur+delta));
  seekCycle(np);
}

/* Reverse play — Fix #4 */
function toggleReverse(){
  S.reverse=!S.reverse;
  document.getElementById('rvBtn').textContent=S.reverse?'↪ Forward':'↩ Reverse';
  document.getElementById('rvBtn').classList.toggle('pri',S.reverse);
  S.trail=[];S.lastRafTime=0;
}

const S={tab:'draw',drawing:false,inputPts:[],centroid:{x:0,y:0},
  fourier:[],fftN:0,time:0,trail:[],running:false,paused:false,animId:null,
  trailCutoff:1,isOpen:false,gaps:[],lastRafTime:0,frameN:0,reverse:false};

function switchTab(t){S.tab=t;const bm={draw:'tdBtn',upload:'tuBtn',text:'ttBtn'};['draw','upload','text'].forEach(id=>{document.getElementById(bm[id]).classList.toggle('active',id===t);document.getElementById('tc-'+id).classList.toggle('active',id===t);});iCv.style.pointerEvents=t==='draw'?'auto':'none';}
function showHint(txt,dur=2000){const h=document.getElementById('hint');h.textContent=txt;h.style.opacity='.55';setTimeout(()=>h.style.opacity='0',dur);}

function evXY(e){const r=iCv.getBoundingClientRect(),s=e.touches?e.touches[0]:e;return{x:s.clientX-r.left,y:s.clientY-r.top};}
iCv.addEventListener('mousedown',e=>startDraw(evXY(e)));
iCv.addEventListener('mousemove',e=>{if(S.drawing)addPt(evXY(e));});
iCv.addEventListener('mouseup',endDraw);iCv.addEventListener('mouseleave',endDraw);
iCv.addEventListener('touchstart',e=>{e.preventDefault();if(e.touches.length===1)startDraw(evXY(e));},{passive:false});
iCv.addEventListener('touchmove',e=>{e.preventDefault();if(e.touches.length===1)addPt(evXY(e));},{passive:false});
iCv.addEventListener('touchend',e=>{e.preventDefault();endDraw();},{passive:false});

function startDraw(pos){if(S.tab!=='draw')return;if(S.running)stopAnim();clearFourier();S.drawing=true;S.inputPts=[pos];S.gaps=[];clr(iCtx);iCtx.setTransform(DPR,0,0,DPR,0,0);iCtx.beginPath();iCtx.moveTo(pos.x,pos.y);document.getElementById('runD').disabled=true;setStatus('run','DRAWING…');}
function addPt(pos){if(!S.drawing)return;const lp=S.inputPts[S.inputPts.length-1];if((pos.x-lp.x)**2+(pos.y-lp.y)**2<4)return;S.inputPts.push(pos);iCtx.lineTo(pos.x,pos.y);iCtx.strokeStyle=document.getElementById('cT').value+'bb';iCtx.lineWidth=2;iCtx.lineCap=iCtx.lineJoin='round';iCtx.stroke();document.getElementById('iPts').textContent=S.inputPts.length;}
function endDraw(){if(!S.drawing)return;S.drawing=false;if(S.inputPts.length>20){document.getElementById('runD').disabled=false;setStatus('on','PATH READY — PRESS ▶');}else setStatus('','IDLE — DRAW MORE');}
function drawInput(){const pts=S.inputPts;if(pts.length<2)return;clr(iCtx);iCtx.save();apV(iCtx);iCtx.beginPath();let cum=0,tot=0;const lens=[];for(let i=0;i<pts.length-1;i++){const d=Math.hypot(pts[i+1].x-pts[i].x,pts[i+1].y-pts[i].y);lens.push(d);tot+=d;}for(let i=0;i<pts.length;i++){const f=tot>0?cum/tot:0;const inG=S.gaps.some(g=>f>=g.s&&f<=g.e);if(i===0||inG)iCtx.moveTo(pts[i].x,pts[i].y);else iCtx.lineTo(pts[i].x,pts[i].y);if(i<lens.length)cum+=lens[i];}iCtx.strokeStyle=document.getElementById('cT').value+'66';iCtx.lineWidth=1.5/V.sc;iCtx.lineCap=iCtx.lineJoin='round';iCtx.stroke();iCtx.restore();}

const uzone=document.getElementById('uzone');
uzone.addEventListener('dragover',e=>{e.preventDefault();uzone.classList.add('over');});
uzone.addEventListener('dragleave',()=>uzone.classList.remove('over'));
uzone.addEventListener('drop',e=>{e.preventDefault();uzone.classList.remove('over');if(e.dataTransfer.files[0])doFile(e.dataTransfer.files[0]);});
function handleFile(e){if(e.target.files[0])doFile(e.target.files[0]);}
function doFile(file){setStatus('run','READING…');upSt('reading…');document.getElementById('runU').disabled=true;const svg=file.name.toLowerCase().endsWith('.svg');const rd=new FileReader();rd.onload=ev=>loadURL(ev.target.result,svg);rd.onerror=()=>setStatus('err','READ ERROR');rd.readAsDataURL(file);}
function loadURL(url,isSvg){const img=new Image();img.onload=()=>{const SZ=720;offC.width=offC.height=SZ;offX.fillStyle='#ffffff';offX.fillRect(0,0,SZ,SZ);const sc=Math.min(SZ/img.width,SZ/img.height);offX.drawImage(img,(SZ-img.width*sc)/2,(SZ-img.height*sc)/2,img.width*sc,img.height*sc);const imgData=offX.getImageData(0,0,SZ,SZ);upSt('extracting…');setTimeout(()=>{const mode=document.getElementById('extMode').value;const result=mode==='sil'?extSilhouette(imgData,SZ,SZ):extLineArt(imgData,SZ,SZ,SZ*0.012);if(!result.pts||result.pts.length<20){setStatus('err','NO PATH');upSt('failed');return;}loadPts(result);document.getElementById('runU').disabled=false;upSt(mode+' · '+result.pts.length+' pts');setStatus('on','LOADED — PRESS ▶');},20);};img.onerror=()=>setStatus('err','LOAD ERROR');img.src=url;}

function processText(){
  const txt=document.getElementById('textIn').value.trim();if(!txt){setStatus('err','ENTER TEXT');return;}
  const font=document.getElementById('fontSel').value;let sz=+document.getElementById('sFS').value;
  const approxW=sz*txt.length*.72,targetW=LW()*.85;
  if(approxW>targetW){sz=Math.max(30,Math.floor(sz*targetW/approxW));document.getElementById('vFSa').textContent='(auto→'+sz+'px)';}
  setStatus('run','RENDERING TEXT…');
  setTimeout(()=>{
    const mc=document.createElement('canvas'),mx=mc.getContext('2d');mx.font=`bold ${sz}px ${font}`;const textW=Math.ceil(mx.measureText(txt).width);
    const W=Math.min(3000,textW+120),H=Math.ceil(sz*2.5);
    offC.width=W;offC.height=H;offX.fillStyle='#ffffff';offX.fillRect(0,0,W,H);offX.font=`bold ${sz}px ${font}`;
    const rmode=document.getElementById('renderMode').value;
    if(rmode==='stroke'){offX.strokeStyle='#000000';offX.lineWidth=Math.max(2.5,sz*.05);offX.lineJoin='round';offX.lineCap='round';offX.strokeText(txt,40,sz*1.25);}
    else{offX.fillStyle='#000000';offX.fillText(txt,40,sz*1.25);}
    const imgData=offX.getImageData(0,0,W,H);
    const mj=rmode==='stroke'?Math.max(8,sz*.08):Math.max(12,sz*.14);
    const result=extLineArt(imgData,W,H,mj);
    if(!result.pts||result.pts.length<10){setStatus('err','TEXT FAILED');return;}
    loadPts(result);document.getElementById('runT').disabled=false;setStatus('on','TEXT PATH READY — PRESS ▶');
  },20);
}

function loadPts(data){const pts=Array.isArray(data)?data:data.pts;S.gaps=Array.isArray(data)?[]:(data.gaps||[]);const mapped=fitCv(pts,LW(),LH());S.inputPts=mapped;clr(iCtx);iCtx.setTransform(DPR,0,0,DPR,0,0);iCtx.beginPath();let cum=0,tot=0;const lens=[];for(let i=0;i<mapped.length-1;i++){const d=Math.hypot(mapped[i+1].x-mapped[i].x,mapped[i+1].y-mapped[i].y);lens.push(d);tot+=d;}for(let i=0;i<mapped.length;i++){const f=tot>0?cum/tot:0;const inG=S.gaps.some(g=>f>=g.s&&f<=g.e);if(i===0||inG)iCtx.moveTo(mapped[i].x,mapped[i].y);else iCtx.lineTo(mapped[i].x,mapped[i].y);if(i<lens.length)cum+=lens[i];}iCtx.strokeStyle=document.getElementById('cT').value+'bb';iCtx.lineWidth=1.4;iCtx.lineCap=iCtx.lineJoin='round';iCtx.stroke();document.getElementById('iPts').textContent=pts.length;}

function getGray(d,N){const g=new Float32Array(N);for(let i=0;i<N;i++)g[i]=(d[i*4]*.299+d[i*4+1]*.587+d[i*4+2]*.114)/255;return g;}
function otsu(gray,N){const h=new Float64Array(256);for(let i=0;i<N;i++)h[Math.min(255,gray[i]*255|0)]++;let sum=0;for(let i=0;i<256;i++)sum+=i*h[i];let sb=0,wb=0,best=0,t=0;for(let i=0;i<256;i++){wb+=h[i];if(!wb)continue;const wf=N-wb;if(!wf)break;sb+=i*h[i];const v=wb*wf*((sb/wb-(sum-sb)/wf)**2);if(v>best){best=v;t=i;}}return t/255;}
function fgB(gray,N,thr){let b=0;for(const g of gray)if(g>thr)b++;return b/N<.55;}
function extSilhouette(imgData,iw,ih){const gray=getGray(imgData.data,iw*ih),thr=otsu(gray,iw*ih);const fg=fgB(gray,iw*ih,thr);const bin=new Uint8Array(iw*ih);for(let i=0;i<gray.length;i++)bin[i]=(fg?gray[i]>thr:gray[i]<=thr)?1:0;let cx=0,cy=0,cnt=0;for(let y=0;y<ih;y++)for(let x=0;x<iw;x++)if(bin[y*iw+x]){cx+=x;cy+=y;cnt++;}if(!cnt)return{pts:[],gaps:[]};cx/=cnt;cy/=cnt;const RAYS=512,pts=[],maxR=Math.ceil(Math.hypot(iw,ih));for(let a=0;a<RAYS;a++){const ang=(a/RAYS)*2*Math.PI,ca=Math.cos(ang),sa=Math.sin(ang);let fx=Math.round(cx),fy=Math.round(cy),found=false;for(let r=1;r<maxR;r++){const nx=Math.round(cx+r*ca),ny=Math.round(cy+r*sa);if(nx<0||nx>=iw||ny<0||ny>=ih)break;if(bin[ny*iw+nx]){fx=nx;fy=ny;found=true;}}if(found)pts.push({x:fx,y:fy});}return{pts,gaps:[]};}
function extLineArt(imgData,iw,ih,maxJump=10){const gray=getGray(imgData.data,iw*ih),thr=otsu(gray,iw*ih);const fg=fgB(gray,iw*ih,thr);const dirs=[[-1,0],[1,0],[0,-1],[0,1]];const pts=[];for(let y=1;y<ih-1;y++)for(let x=1;x<iw-1;x++){const isFg=fg?gray[y*iw+x]>thr:gray[y*iw+x]<=thr;if(!isFg)continue;let edge=false;for(const[dx,dy]of dirs){const ng=gray[(y+dy)*iw+(x+dx)];if(!(fg?ng>thr:ng<=thr)){edge=true;break;}}if(edge)pts.push({x,y});}if(!pts.length)return{pts:[],gaps:[]};const sub=gridSub(pts,3000);const traced=nnTrace(sub,maxJump);const smoothed=smoothPts(traced.pts,traced.gaps,6);const optimized=optimizeSegs({pts:smoothed,gaps:traced.gaps});return optimized;}
function gridSub(pts,maxN){if(pts.length<=maxN)return pts;const step=Math.ceil(Math.sqrt(pts.length/maxN));const seen=new Set(),out=[];for(const p of pts){const k=`${p.x/step|0},${p.y/step|0}`;if(!seen.has(k)){seen.add(k);out.push(p);}}return out;}
function nnTrace(pts,maxJump){const n=pts.length;if(!n)return{pts:[],gaps:[]};const used=new Uint8Array(n);const out=[pts[0]];used[0]=1;const cell=Math.max(1,maxJump/3|0);const gm=new Map();for(let i=0;i<n;i++){const k=`${pts[i].x/cell|0},${pts[i].y/cell|0}`;if(!gm.has(k))gm.set(k,[]);gm.get(k).push(i);}const rad=Math.ceil(maxJump/cell)+1;for(let iter=1;iter<n;iter++){const last=out[out.length-1],cx=last.x/cell|0,cy=last.y/cell|0;let best=-1,bd=Infinity;for(let dy=-rad;dy<=rad;dy++)for(let dx=-rad;dx<=rad;dx++){const c=gm.get(`${cx+dx},${cy+dy}`);if(!c)continue;for(const i of c){if(used[i])continue;const d=(pts[i].x-last.x)**2+(pts[i].y-last.y)**2;if(d<bd){bd=d;best=i;}}}if(best===-1){for(let i=0;i<n;i++){if(used[i])continue;const d=(pts[i].x-last.x)**2+(pts[i].y-last.y)**2;if(d<bd){bd=d;best=i;}}}if(best===-1)break;used[best]=1;out.push(pts[best]);}const steps=[];let tot=0;for(let i=0;i<out.length-1;i++){const d=Math.hypot(out[i+1].x-out[i].x,out[i+1].y-out[i].y);steps.push(d);tot+=d;}const gapThr=maxJump*3;const gaps=[];let cum=0;for(let i=0;i<steps.length;i++){if(steps[i]>gapThr)gaps.push({s:cum/tot,e:(cum+steps[i])/tot});cum+=steps[i];}return{pts:out,gaps};}
function smoothPts(pts,gaps,radius){const n=pts.length;if(n<3||radius<1)return pts;let tot=0;const cum=[0];for(let i=0;i<n-1;i++){tot+=Math.hypot(pts[i+1].x-pts[i].x,pts[i+1].y-pts[i].y);cum.push(tot);}const gm=new Uint8Array(n);if(tot>0)for(let i=0;i<n;i++){const f=cum[i]/tot;for(const g of gaps)if(f>=g.s-.003&&f<=g.e+.003){gm[i]=1;break;}}return pts.map((p,i)=>{if(gm[i])return p;let sx=0,sy=0,w=0;for(let j=-radius;j<=radius;j++){const k=Math.max(0,Math.min(n-1,i+j));if(gm[k])continue;const wj=1/(1+Math.abs(j)*.5);sx+=pts[k].x*wj;sy+=pts[k].y*wj;w+=wj;}return w>0?{x:sx/w,y:sy/w}:p;});}
function optimizeSegs(traced){const{pts,gaps}=traced;if(!gaps.length||pts.length<4)return traced;const segs=splitAtGaps(pts,gaps);if(segs.length<=1)return traced;return reconnect(greedySort(segs));}
function splitAtGaps(pts,gaps){if(!gaps.length||!pts.length)return[pts];let tot=0;const lens=[];for(let i=0;i<pts.length-1;i++){const d=Math.hypot(pts[i+1].x-pts[i].x,pts[i+1].y-pts[i].y);lens.push(d);tot+=d;}const segs=[];let segStart=0,cum=0;for(let i=0;i<lens.length;i++){const f=cum/tot;if(gaps.some(g=>f>=g.s-.001&&f<=g.e+.001)){if(i>=segStart)segs.push(pts.slice(segStart,i+1));segStart=i+1;}cum+=lens[i];}segs.push(pts.slice(segStart));return segs.filter(s=>s.length>=2);}
function greedySort(segs){if(segs.length<=1)return segs;const result=[segs[0]],rem=[...segs.slice(1)];while(rem.length){const last=result[result.length-1],lp=last[last.length-1];let bi=0,bd=Infinity,rev=false;for(let i=0;i<rem.length;i++){const s=rem[i],d1=Math.hypot(lp.x-s[0].x,lp.y-s[0].y),d2=Math.hypot(lp.x-s[s.length-1].x,lp.y-s[s.length-1].y);if(d1<bd){bd=d1;bi=i;rev=false;}if(d2<bd){bd=d2;bi=i;rev=true;}}let seg=rem.splice(bi,1)[0];if(rev)seg=[...seg].reverse();result.push(seg);}return result;}
function reconnect(segs){if(!segs.length)return{pts:[],gaps:[]};const pts=[];for(const s of segs)for(const p of s)pts.push(p);const steps=[];let tot=0;for(let i=0;i<pts.length-1;i++){const d=Math.hypot(pts[i+1].x-pts[i].x,pts[i+1].y-pts[i].y);steps.push(d);tot+=d;}const segLens=segs.map(s=>{let l=0;for(let i=0;i<s.length-1;i++)l+=Math.hypot(s[i+1].x-s[i].x,s[i+1].y-s[i].y);return l;});const gaps=[];let cum=0;for(let si=0;si<segs.length-1;si++){cum+=segLens[si];const connLen=Math.hypot(segs[si][segs[si].length-1].x-segs[si+1][0].x,segs[si][segs[si].length-1].y-segs[si+1][0].y);if(connLen>3&&tot>0)gaps.push({s:cum/tot,e:(cum+connLen)/tot});cum+=connLen;}return{pts,gaps};}
function fitCv(pts,cw,ch,mg=.1){const xs=pts.map(p=>p.x),ys=pts.map(p=>p.y);const x0=Math.min(...xs),x1=Math.max(...xs),y0=Math.min(...ys),y1=Math.max(...ys);const sc=Math.min(cw*(1-2*mg)/(x1-x0||1),ch*(1-2*mg)/(y1-y0||1));const ox=(cw-(x1-x0)*sc)/2,oy=(ch-(y1-y0)*sc)/2;return pts.map(p=>({x:(p.x-x0)*sc+ox,y:(p.y-y0)*sc+oy}));}

const nxt2=n=>{let p=1;while(p<n)p<<=1;return p;};
function fftIP(re,im){const N=re.length;for(let i=1,j=0;i<N;i++){let b=N>>1;for(;j&b;b>>=1)j^=b;j^=b;if(i<j){let t=re[i];re[i]=re[j];re[j]=t;t=im[i];im[i]=im[j];im[j]=t;}}for(let len=2;len<=N;len<<=1){const a=-2*Math.PI/len,wc=Math.cos(a),ws=Math.sin(a);for(let i=0;i<N;i+=len){let wr=1,wi=0;for(let j=0,h=len>>1;j<h;j++){const ur=re[i+j],ui=im[i+j],vr=re[i+j+h]*wr-im[i+j+h]*wi,vi=im[i+j+h]*wr+re[i+j+h]*wi;re[i+j]=ur+vr;im[i+j]=ui+vi;re[i+j+h]=ur-vr;im[i+j+h]=ui-vi;const nwr=wr*wc-wi*ws;wi=wr*ws+wi*wc;wr=nwr;}}}}
function computeFFT(pts){const N=nxt2(pts.length),re=new Float64Array(N),im=new Float64Array(N);for(let i=0;i<pts.length;i++){re[i]=pts[i].x;im[i]=pts[i].y;}fftIP(re,im);const out=[];for(let k=0;k<N;k++)out.push({freq:k<=N/2?k:k-N,amp:Math.hypot(re[k],im[k])/N,phase:Math.atan2(im[k],re[k])});return out.sort((a,b)=>b.amp-a.amp);}
function resample(pts,N){const n=pts.length;if(n<=1)return pts;const lens=new Float64Array(n);let tot=0;for(let i=0;i<n;i++){const j=(i+1)%n;lens[i]=Math.hypot(pts[j].x-pts[i].x,pts[j].y-pts[i].y);tot+=lens[i];}if(!tot)return pts;const cum=new Float64Array(n+1);for(let i=0;i<n;i++)cum[i+1]=cum[i]+lens[i];const out=[];let seg=0;for(let k=0;k<N;k++){const tgt=(k/N)*tot;while(seg<n-1&&cum[seg+1]<tgt)seg++;const t=lens[seg]>0?(tgt-cum[seg])/lens[seg]:0,j=(seg+1)%n;out.push({x:pts[seg].x+t*(pts[j].x-pts[seg].x),y:pts[seg].y+t*(pts[j].y-pts[seg].y)});}return out;}
function computeCutoff(raw){const n=raw.length;if(n<2)return{cutoff:1,isOpen:false};let rLen=0;for(let i=0;i<n-1;i++)rLen+=Math.hypot(raw[i+1].x-raw[i].x,raw[i+1].y-raw[i].y);const cLen=Math.hypot(raw[0].x-raw[n-1].x,raw[0].y-raw[n-1].y);const THR=Math.max(20,Math.min(LW(),LH())*.025);return cLen<THR?{cutoff:1,isOpen:false}:{cutoff:rLen/(rLen+cLen),isOpen:true};}

/* Full tip: zoom-adaptive threshold */
function computeTip(nEpc,time){let x=S.centroid.x,y=S.centroid.y;const n=Math.min(nEpc,S.fourier.length);const minA=Math.max(0.0001,0.01/Math.min(V.sc,200));for(let i=0;i<n;i++){const{freq,amp,phase}=S.fourier[i];if(amp<minA)continue;const a=freq*time+phase;x+=amp*Math.cos(a);y+=amp*Math.sin(a);}return{x,y};}
/* Fast tip for trail pre-population (top 400 components, early exit) */
function computeTipFast(nEpc,time){let x=S.centroid.x,y=S.centroid.y;const n=Math.min(nEpc,S.fourier.length,400);for(let i=0;i<n;i++){const{freq,amp,phase}=S.fourier[i];if(amp<0.05)break; // Early exit since sorted by amplitude
  const a=freq*time+phase;x+=amp*Math.cos(a);y+=amp*Math.sin(a);}return{x,y};}

function startFourier(){
  if(!S.inputPts.length){setStatus('err','NO PATH');return;}
  stopAnim();resetV();setStatus('run','COMPUTING FFT…');S.reverse=false;
  document.getElementById('rvBtn').textContent='↩ Reverse';document.getElementById('rvBtn').classList.remove('pri');
  ['runD','runU','runT'].forEach(id=>document.getElementById(id).disabled=true);
  setTimeout(()=>{
    const{cutoff,isOpen}=computeCutoff(S.inputPts);S.trailCutoff=cutoff;S.isOpen=isOpen;
    const gapScale=isOpen?cutoff:1.0;S.gaps=S.gaps.map(g=>({s:g.s*gapScale,e:g.e*gapScale}));
    const TARGET=FSIZES[+document.getElementById('sFR').value];
    const uniform=resample(S.inputPts,TARGET);
    let cx=0,cy=0;for(const p of uniform){cx+=p.x;cy+=p.y;}cx/=uniform.length;cy/=uniform.length;S.centroid={x:cx,y:cy};
    S.fourier=computeFFT(uniform.map(p=>({x:p.x-cx,y:p.y-cy})));
    S.fftN=nxt2(uniform.length);S.time=0;S.trail=[];S.running=true;S.paused=false;S.lastRafTime=0;S.frameN=0;
    document.getElementById('iN').textContent=S.fftN;document.getElementById('iEpc').textContent=S.fourier.length;
    document.getElementById('pBtn').disabled=false;document.getElementById('rBtn').disabled=false;document.getElementById('rvBtn').disabled=false;document.getElementById('eqBtn').disabled=false;
    iCv.style.pointerEvents='none';document.getElementById('seekSection').classList.add('vis');document.getElementById('sCyc').value=0;document.getElementById('vCycPct').textContent='0%';
    setStatus('run',isOpen?'RUNNING (OPEN PATH)':'RUNNING');
    showHint('SCROLL TO ZOOM · DRAG TO PAN',3000);
    animate();
  },30);
}

function buildChain(nEpc,time,minAmp){const chain=[{x:S.centroid.x,y:S.centroid.y}];let x=S.centroid.x,y=S.centroid.y;for(let i=0;i<nEpc;i++){const{freq,amp,phase}=S.fourier[i];if(amp<minAmp)continue;const a=freq*time+phase;x+=amp*Math.cos(a);y+=amp*Math.sin(a);chain.push({x,y,amp,epiIdx:i});}return chain;}

function animate(){
  if(!S.running)return;
  const now=performance.now();const elapsed=S.lastRafTime?now-S.lastRafTime:16;S.lastRafTime=now;
  const shouldAdvance=!S.paused&&elapsed<250;
  const nEpc=Math.min(+document.getElementById('sE').value,S.fourier.length);
  const spd=getSpd();const maxTr=+document.getElementById('sTl').value;
  const renderMin=(+document.getElementById('sMn').value/10)/V.sc;
  const cOp=+document.getElementById('sCO').value/100,cSW=+document.getElementById('sCS').value/10,lW=+document.getElementById('sLW').value/10;
  const showC=document.getElementById('tSC').checked,showA=document.getElementById('tSA').checked;
  const doFd=document.getElementById('tTF').checked,showI=document.getElementById('tSD').checked;
  const showTR=document.getElementById('tTR').checked,showCR=document.getElementById('tCR').checked;
  const cC=document.getElementById('cC').value,cA=document.getElementById('cA').value,cT=document.getElementById('cT').value;
  const stepsPerFrame=Math.max(1,Math.min(24,Math.ceil(spd)));
  const dt=(2*Math.PI/S.fftN)*spd,subDt=dt/stepsPerFrame;

  const chain=buildChain(nEpc,S.time,renderMin);
  const fm=document.getElementById('followSel').value;
  if(fm!=='off'){const tp=fm==='tip'?computeTip(nEpc,S.time):(chain[Math.min(+document.getElementById('sFE').value,chain.length-1)]||computeTip(nEpc,S.time));V.tx=LW()/2-tp.x*V.sc;V.ty=LH()/2-tp.y*V.sc;}
  document.getElementById('tring').classList.toggle('vis',fm!=='off'&&showCR);

  clr(fCtx);clr(iCtx);
  if(showI&&S.inputPts.length>1)drawInput();
  fCtx.save();apV(fCtx);
  const cAlpH=Math.round(cOp*255).toString(16).padStart(2,'00');
  for(let i=0;i<chain.length-1;i++){
    const fr=chain[i],to=chain[i+1],amp=to.amp;
    const tracked=showTR&&fm==='epi'&&+document.getElementById('sFE').value===i+1;
    if(showC){fCtx.beginPath();fCtx.arc(fr.x,fr.y,amp,0,2*Math.PI);fCtx.strokeStyle=tracked?(cC+'ff'):(cC+cAlpH);fCtx.lineWidth=(tracked?cSW*2:cSW)/V.sc;fCtx.stroke();}
    if(showA){fCtx.beginPath();fCtx.moveTo(fr.x,fr.y);fCtx.lineTo(to.x,to.y);fCtx.strokeStyle=tracked?(cA+'ff'):(cA+'bb');fCtx.lineWidth=lW/V.sc;fCtx.stroke();if(amp>renderMin*3){const dir=Math.atan2(to.y-fr.y,to.x-fr.x),al=Math.min(8,amp*.4);fCtx.beginPath();fCtx.moveTo(to.x,to.y);fCtx.lineTo(to.x-al*Math.cos(dir-.38),to.y-al*Math.sin(dir-.38));fCtx.lineTo(to.x-al*Math.cos(dir+.38),to.y-al*Math.sin(dir+.38));fCtx.closePath();fCtx.fillStyle=tracked?(cA+'ff'):(cA+'bb');fCtx.fill();}}
  }

  const tl=S.trail.length;
  if(tl>1){
    const tw=lW*1.5/V.sc;
    // Bidirectional gap detection (works for both forward and reverse play)
    const isGap=i=>{const dcf=S.trail[i].cf-S.trail[i-1].cf;const d=Math.hypot(S.trail[i].x-S.trail[i-1].x,S.trail[i].y-S.trail[i-1].y);return Math.abs(dcf)>.015||(Math.abs(dcf)>.005&&d>40/V.sc);};
    const draw=(si,ei,alph)=>{fCtx.beginPath();fCtx.moveTo(S.trail[si].x,S.trail[si].y);for(let i=si+1;i<=ei&&i<tl;i++){if(isGap(i))fCtx.moveTo(S.trail[i].x,S.trail[i].y);else fCtx.lineTo(S.trail[i].x,S.trail[i].y);}fCtx.strokeStyle=cT+alph;fCtx.lineWidth=tw;fCtx.lineJoin=fCtx.lineCap='round';fCtx.stroke();};
    if(doFd&&tl>80){const SEG=8;for(let s=0;s<SEG;s++){const si=(s/SEG*tl)|0,ei=((s+1)/SEG*tl)|0;if(ei<=si)continue;fCtx.lineWidth=tw*(.5+s*.08);draw(si,ei,Math.round(16+s*32).toString(16).padStart(2,'0'));}}
    else draw(0,tl-1,'dd');
  }
  fCtx.restore();

  if(shouldAdvance){
    for(let step=0;step<stepsPerFrame;step++){
      const cf=S.time/(2*Math.PI);
      const inGap=S.gaps.length>0&&S.gaps.some(g=>cf>=g.s-.002&&cf<=g.e+.002);
      const inRet=S.isOpen&&cf>=S.trailCutoff;
      if(!inGap&&!inRet){const tip=computeTip(nEpc,S.time);S.trail.push({x:tip.x,y:tip.y,cf});if(S.trail.length>maxTr)S.trail.shift();}
      if(S.reverse){S.time-=subDt;if(S.time<0){S.time=2*Math.PI;S.trail=[];break;}}
      else{S.time+=subDt;if(S.time>=2*Math.PI){S.time=0;S.trail=[];break;}}
    }
    const pct=S.time/(2*Math.PI)*100;
    document.getElementById('iProg').textContent=Math.min(100,pct|0)+'%';
    if((S.frameN%6)===0){document.getElementById('sCyc').value=pct.toFixed(1);document.getElementById('vCycPct').textContent=Math.round(pct)+'%';}
  }
  S.frameN=(S.frameN||0)+1;
  S.animId=requestAnimationFrame(animate);
}

function togglePause(){S.paused=!S.paused;document.getElementById('pBtn').textContent=S.paused?'▶ Resume':'⏸ Pause';setStatus(S.paused?'on':'run',S.paused?'PAUSED':'RUNNING');}
function restartAnim(){S.time=S.reverse?2*Math.PI:0;S.trail=[];S.paused=false;S.lastRafTime=0;document.getElementById('pBtn').textContent='⏸ Pause';setStatus('run','RUNNING');document.getElementById('sCyc').value=S.reverse?100:0;document.getElementById('vCycPct').textContent=S.reverse?'100%':'0%';}
function stopAnim(){cancelAnimationFrame(S.animId);S.running=false;S.paused=false;clr(fCtx);clr(iCtx);S.trail=[];S.time=0;S.lastRafTime=0;}
function clearFourier(){stopAnim();S.fourier=[];S.fftN=0;S.reverse=false;['pBtn','rBtn','rvBtn','eqBtn'].forEach(id=>document.getElementById(id).disabled=true);document.getElementById('iN').textContent='—';document.getElementById('iEpc').textContent='—';document.getElementById('iProg').textContent='0%';document.getElementById('seekSection').classList.remove('vis');document.getElementById('rvBtn').textContent='↩ Reverse';document.getElementById('rvBtn').classList.remove('pri');}
function clearAll(){clearFourier();S.inputPts=[];S.gaps=[];clr(iCtx);iCv.style.pointerEvents=S.tab==='draw'?'auto':'none';['runD','runU','runT'].forEach(id=>document.getElementById(id).disabled=true);document.getElementById('iPts').textContent='0';resetV();setStatus('','IDLE');upSt('');document.getElementById('vFSa').textContent='';}
function onFollow(){const m=document.getElementById('followSel').value;document.getElementById('epiRow').style.display=m==='epi'?'block':'none';document.getElementById('tring').classList.toggle('vis',m!=='off'&&document.getElementById('tCR').checked);}

/* ═══ EQUATION MODAL — Rebuilt with working tabs ═══ */
function eqTab(btn){
  // Remove active from all tabs and panes
  document.querySelectorAll('#eqTabs .eq-tb').forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.eq-pane').forEach(p=>p.classList.remove('active'));
  // Activate clicked tab and its pane
  btn.classList.add('active');
  const paneName=btn.getAttribute('data-pane');
  document.getElementById('ep-'+paneName).classList.add('active');
  if(paneName==='spectrum')setTimeout(drawSpectrum,50);
}
function openEq(){
  if(!S.fourier.length)return;
  buildFormula();buildExport();
  document.getElementById('eqOv').classList.add('vis');
  // Ensure formula tab is active
  const tabs=document.querySelectorAll('#eqTabs .eq-tb');
  tabs.forEach(b=>b.classList.remove('active'));
  document.querySelectorAll('.eq-pane').forEach(p=>p.classList.remove('active'));
  tabs[0].classList.add('active');
  document.getElementById('ep-formula').classList.add('active');
}
function closeEq(){document.getElementById('eqOv').classList.remove('vis');}

function buildFormula(){
  const tot=S.fourier.reduce((s,c)=>s+c.amp,0);
  const terms=S.fourier.slice(0,8).map(c=>{const f=c.freq===0?'0':c.freq>0?`+${c.freq}`:`${c.freq}`;const ph=c.phase>=0?`+${c.phase.toFixed(3)}`:`${c.phase.toFixed(3)}`;return`${c.amp.toFixed(2)}·e^{i(${f}t${ph})}`;}).join('\n  + ');
  document.getElementById('eqCode').innerHTML=`<span style="color:var(--acc)">z(t)</span> = Σ Aₙ · exp(i·(fₙ·t + φₙ))   [N = ${S.fftN}]\n\nz(t) ≈ ${terms}\n  + … [${S.fourier.length} total components]\n\nSum of amplitudes : <span style="color:var(--acc)">${tot.toFixed(2)} px</span>   |   <span style="color:var(--acc)">${S.isOpen?'OPEN PATH':'CLOSED LOOP'}</span>`;
  const rows=S.fourier.slice(0,80).map((c,i)=>`<tr><td>${i+1}</td><td>${c.freq>=0?'+':''}${c.freq}</td><td>${c.amp.toFixed(4)}</td><td>${c.phase.toFixed(5)}</td><td>${c.freq===0?'DC':c.freq>0?'↺ CCW':'↻ CW'}</td><td>${(c.amp/tot*100).toFixed(2)}%</td></tr>`).join('');
  const more=S.fourier.length>80?`<tr><td colspan="6" style="color:var(--dim);text-align:center;padding:.5rem">… ${S.fourier.length-80} more components</td></tr>`:'';
  document.getElementById('eqTbl').innerHTML=`<tr><th>#</th><th>Freq</th><th>Amp (px)</th><th>Phase (rad)</th><th>Direction</th><th>% of total</th></tr>${rows}${more}`;
}

function drawSpectrum(){
  const sc=document.getElementById('specCv');
  const wrap=sc.parentElement;
  const W=(wrap.clientWidth||640)*DPR;
  const H=(wrap.clientHeight||240)*DPR;
  sc.width=W;sc.height=H;
  const ctx=sc.getContext('2d');
  ctx.clearRect(0,0,W,H);
  if(!S.fourier.length)return;

  // Take top 250 by amplitude, then sort by frequency for display
  const N=Math.min(S.fourier.length,250);
  const comps=[...S.fourier.slice(0,N)].sort((a,b)=>a.freq-b.freq);
  const maxFreq=Math.max(1,...comps.map(c=>Math.abs(c.freq)));
  const maxAmp=S.fourier[0].amp;

  const ml=45*DPR,mr=20*DPR,mb=30*DPR,mt=15*DPR;
  const plotW=W-ml-mr,plotH=H-mt-mb;

  // Draw background grid
  ctx.strokeStyle='rgba(128,128,128,0.15)';ctx.lineWidth=DPR;
  for(let i=0;i<=4;i++){const y=mt+plotH*(1-i/4);ctx.beginPath();ctx.moveTo(ml,y);ctx.lineTo(W-mr,y);ctx.stroke();}

  // Draw bars
  const barMaxW=Math.max(3*DPR,plotW/(2*maxFreq+2)*1.8);
  comps.forEach(c=>{
    const x=ml+(c.freq+maxFreq)/(2*maxFreq)*plotW;
    const h=Math.max(2*DPR,(c.amp/maxAmp)*plotH);
    ctx.fillStyle=c.freq===0?'#c8a030':c.freq>0?'#3060c8':'#c04060';
    ctx.globalAlpha=0.88;
    ctx.fillRect(x-barMaxW/2,mt+plotH-h,barMaxW,h);
  });
  ctx.globalAlpha=1;

  // X axis
  ctx.strokeStyle='rgba(128,128,128,0.6)';ctx.lineWidth=DPR;
  ctx.beginPath();ctx.moveTo(ml,mt+plotH);ctx.lineTo(W-mr,mt+plotH);ctx.stroke();

  // Y axis labels
  ctx.fillStyle='var(--dim)';
  try{ctx.fillStyle=getComputedStyle(document.documentElement).getPropertyValue('--dim').trim();}catch(e){}
  ctx.font=`${10*DPR}px Share Tech Mono,monospace`;ctx.textAlign='right';
  for(let i=0;i<=4;i++){const y=mt+plotH*(1-i/4);ctx.fillText((maxAmp*i/4).toFixed(1),ml-4,y+4);}

  // X axis labels
  ctx.textAlign='center';
  ctx.fillText('-'+maxFreq,ml,mt+plotH+18*DPR);
  ctx.fillText('0',ml+plotW/2,mt+plotH+18*DPR);
  ctx.fillText('+'+maxFreq,W-mr,mt+plotH+18*DPR);

  // Y label
  ctx.save();ctx.translate(12*DPR,mt+plotH/2);ctx.rotate(-Math.PI/2);
  ctx.textAlign='center';ctx.fillText('amp (px)',0,0);ctx.restore();
}

function buildExport(){
  document.getElementById('expSH').textContent='N='+S.fftN+'\n'+S.fourier.map(c=>`${c.freq}:${c.amp.toFixed(4)}∠${c.phase.toFixed(5)}`).join('  ');
  document.getElementById('expJS').textContent=JSON.stringify({N:S.fftN,c:S.fourier.map(c=>[c.freq,+c.amp.toFixed(4),+c.phase.toFixed(5)])});
}
function cpExp(type){const el=document.getElementById(type==='SH'?'expSH':'expJS');navigator.clipboard.writeText(el.textContent).catch(()=>{});}

function setStatus(t,msg){document.getElementById('sDot').className='dot'+(t?' '+t:'');document.getElementById('sTxt').textContent=msg;}
function upSt(t){document.getElementById('upSt').textContent=t;}
</script>
