<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fourier Drawing Machine</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Dancing+Script:wght@400;700&family=Pacifico&family=Caveat:wght@400;700&family=Satisfy&family=Great+Vibes&family=Sacramento&family=Alex+Brush&family=Lobster&family=Courgette&family=Cookie&family=Yellowtail&family=Kaushan+Script&family=Permanent+Marker&family=Indie+Flower&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f4f0e5;--surf:#ece7d5;--brd:#cec6ae;
  --acc:#1c3878;--a2:#781428;--a3:#7a4c14;
  --fg:#18140c;--dim:#7a7060;--cbg:#e8e2ce;
  --grid:rgba(28,56,120,.034);
  --glow:0 0 15px rgba(28,56,120,.27);--g2:0 0 15px rgba(120,20,40,.27);
  --fs:.78rem;
}
/* Dark mode = exact colour inversion of light mode (Windows 11 style) */
[data-theme="dark"]{
  --bg:#0b0f1a;   /* inv #f4f0e5 */
  --surf:#13182a;  /* inv #ece7d5 */
  --brd:#313951;   /* inv #cec6ae */
  --acc:#e3c787;   /* inv #1c3878 */
  --a2:#87ebd7;    /* inv #781428 */
  --a3:#85b3eb;    /* inv #7a4c14 */
  --fg:#e7ebf3;    /* inv #18140c */
  --dim:#858f9f;   /* inv #7a7060 */
  --cbg:#171d31;   /* inv #e8e2ce */
  --grid:rgba(227,199,135,.034);
  --glow:0 0 15px rgba(227,199,135,.27);
  --g2:0 0 15px rgba(135,235,215,.27);
}
*{margin:0;padding:0;box-sizing:border-box}html,body{height:100%;overflow:hidden}
body{background:var(--bg);color:var(--fg);font-family:'Share Tech Mono',monospace;font-size:var(--fs);display:flex;flex-direction:column;transition:background .3s,color .3s}
.scanline{position:fixed;inset:0;pointer-events:none;z-index:9999;opacity:0;transition:opacity .3s;
  background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,.04) 2px,rgba(0,0,0,.04) 4px)}
[data-theme="dark"] .scanline{opacity:1;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(255,255,255,.03) 2px,rgba(255,255,255,.03) 4px)}
.app{height:100%;display:grid;grid-template-columns:272px 1fr;gap:0;padding:0;transition:grid-template-columns .32s}
.app.sb-off{grid-template-columns:0px 1fr}
@media(max-width:640px){html,body{overflow:auto}.app{grid-template-columns:1fr!important;height:auto}.sidebar{order:2}.main-area{order:1;min-height:70vw}}
.sidebar{display:flex;flex-direction:column;gap:0;overflow-y:auto;overflow-x:hidden;scrollbar-width:thin;scrollbar-color:var(--brd) transparent;transition:opacity .28s}
.app.sb-off .sidebar{opacity:0;pointer-events:none}
.panel-tab{background:var(--surf);border:1px solid var(--brd);border-bottom:none;padding:.3rem .78rem;font-family:'Orbitron',sans-serif;font-size:.48rem;letter-spacing:.18em;color:var(--acc);flex-shrink:0;position:relative;display:inline-flex;align-items:center;gap:.5rem}
.panel-tab::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,var(--acc),transparent)}
.panel-tab .ptd{width:5px;height:5px;border-radius:50%;background:var(--acc);box-shadow:0 0 4px var(--acc);flex-shrink:0}
.pg{height:.42rem}
.panel{background:var(--surf);border:1px solid var(--brd);padding:.68rem .76rem;position:relative;flex-shrink:0;transition:background .3s,border-color .3s}
.panel::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,var(--acc),transparent)}
.pt{font-family:'Orbitron',sans-serif;font-size:.52rem;letter-spacing:.24em;color:var(--acc);margin-bottom:.55rem;text-transform:uppercase}
.tab-row{display:grid;gap:3px;margin-bottom:.55rem}.t2{grid-template-columns:1fr 1fr}.t3{grid-template-columns:1fr 1fr 1fr}
.tb{background:transparent;border:1px solid var(--brd);color:var(--dim);font-family:'Share Tech Mono',monospace;font-size:var(--fs);padding:.35rem;cursor:pointer;letter-spacing:.05em;transition:all .15s;text-align:center}
.tb.active{background:color-mix(in srgb,var(--acc) 13%,transparent);border-color:var(--acc);color:var(--acc);box-shadow:var(--glow)}
.tb:hover:not(.active){border-color:var(--dim);color:var(--fg)}
.tc{display:none}.tc.active{display:block}
.uzone{border:1px dashed var(--dim);padding:.8rem .5rem;text-align:center;cursor:pointer;transition:all .2s;position:relative}
.uzone:hover,.uzone.over{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 5%,transparent)}
.uzone input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%}
.uzone p{font-size:.65rem;color:var(--dim);line-height:1.65}
.ctrl{margin-bottom:.46rem}
.ctrl label{display:flex;justify-content:space-between;align-items:center;font-size:var(--fs);color:var(--dim);margin-bottom:.2rem;letter-spacing:.05em}
.ctrl label span{color:var(--acc)}
.lbl-btn{background:var(--bg);border:1px solid var(--brd);color:var(--dim);font-family:'Share Tech Mono',monospace;font-size:.46rem;padding:.08rem .28rem;cursor:pointer;letter-spacing:.07em;margin-left:.2rem;transition:all .15s}
.lbl-btn:hover{border-color:var(--acc);color:var(--acc)}
input[type=range]{width:100%;-webkit-appearance:none;height:4px;background:var(--brd);outline:none;cursor:pointer;border-radius:2px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--acc);box-shadow:0 0 5px var(--acc);cursor:pointer}
.num-ctrl{display:flex;align-items:center;gap:.18rem;margin-bottom:.2rem}
.num-ctrl input[type=number]{flex:1;min-width:0;background:var(--bg);border:1px solid var(--brd);color:var(--fg);font-family:'Share Tech Mono',monospace;font-size:var(--fs);padding:.2rem .28rem;text-align:center;outline:none;-moz-appearance:textfield;transition:border-color .15s}
.num-ctrl input[type=number]:focus{border-color:var(--acc)}
.num-ctrl input[type=number]::-webkit-inner-spin-button,.num-ctrl input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none}
.num-ctrl .sb{background:var(--surf);border:1px solid var(--brd);color:var(--dim);font-family:'Share Tech Mono',monospace;font-size:.58rem;width:22px;height:22px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .15s;padding:0;user-select:none}
.num-ctrl .sb:hover{border-color:var(--acc);color:var(--acc)}
.num-ctrl .sbw{width:30px;font-size:.52rem}
.tinput{width:100%;background:var(--bg);border:1px solid var(--brd);color:var(--fg);font-family:'Share Tech Mono',monospace;font-size:var(--fs);padding:.35rem .48rem;outline:none;transition:border-color .2s;margin-bottom:.38rem}
.tinput:focus{border-color:var(--acc)}
select{background:var(--surf);border:1px solid var(--brd);color:var(--fg);font-family:'Share Tech Mono',monospace;font-size:var(--fs);padding:.3rem .42rem;cursor:pointer;width:100%;outline:none;margin-bottom:.38rem}
.font-prev{border:1px solid var(--brd);padding:.3rem .5rem;text-align:center;color:var(--acc);margin-bottom:.38rem;min-height:2.1rem;line-height:1.2;font-size:1.1rem;transition:font-family .3s}
.crow{display:flex;align-items:center;gap:.38rem;margin-bottom:.34rem}
.crow label{font-size:var(--fs);color:var(--dim);flex:1;letter-spacing:.05em}
input[type=color]{width:26px;height:16px;border:1px solid var(--brd);background:transparent;cursor:pointer;padding:0}
.trow{display:flex;align-items:center;justify-content:space-between;margin-bottom:.33rem;font-size:var(--fs);color:var(--dim)}
.pill{position:relative;width:36px;height:19px;cursor:pointer;flex-shrink:0}
.pill input{opacity:0;width:0;height:0;position:absolute}
.pill-tr{position:absolute;inset:0;background:var(--brd);border-radius:10px;transition:background .2s}
.pill-dt{position:absolute;top:3px;left:3px;width:13px;height:13px;background:var(--dim);border-radius:50%;transition:all .2s}
.pill input:checked~.pill-tr{background:var(--acc)}.pill input:checked~.pill-dt{left:20px;background:#fff}
.btn{background:transparent;border:1px solid var(--acc);color:var(--acc);font-family:'Share Tech Mono',monospace;font-size:var(--fs);padding:.42rem;cursor:pointer;letter-spacing:.09em;text-transform:uppercase;transition:all .15s;width:100%;margin-bottom:.3rem;display:block}
.btn:hover{background:color-mix(in srgb,var(--acc) 12%,transparent);box-shadow:var(--glow)}
.btn.pri{background:color-mix(in srgb,var(--acc) 10%,transparent)}
.btn.rev{border-color:var(--a3);color:var(--a3)}
.btn.rev:hover{background:color-mix(in srgb,var(--a3) 11%,transparent);box-shadow:0 0 15px rgba(122,76,20,.27)}
.btn.danger{border-color:var(--a2);color:var(--a2)}
.btn.danger:hover{background:color-mix(in srgb,var(--a2) 11%,transparent);box-shadow:var(--g2)}
.btn:disabled{opacity:.2;cursor:not-allowed;pointer-events:none}
.srow{display:flex;align-items:center;margin-top:.52rem}
.dot{width:6px;height:6px;border-radius:50%;background:var(--dim);margin-right:.38rem;flex-shrink:0}
.dot.on{background:var(--acc);box-shadow:0 0 4px var(--acc)}
.dot.run{background:var(--a3);box-shadow:0 0 4px var(--a3);animation:blink .7s infinite}
.dot.err{background:var(--a2);box-shadow:0 0 4px var(--a2)}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.12}}
.stxt{font-size:var(--fs);color:var(--dim);letter-spacing:.04em}
.main-area{display:flex;flex-direction:column;gap:0;min-height:0}
.zbar{position:absolute;top:.5rem;right:.5rem;z-index:20;display:flex;align-items:center;gap:.16rem}
.zbtn{background:var(--surf);border:1px solid var(--brd);color:var(--fg);font-family:'Share Tech Mono',monospace;font-size:.68rem;width:25px;height:21px;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;letter-spacing:0;transition:all .15s}
.zbtn:hover{border-color:var(--acc);color:var(--acc);box-shadow:var(--glow)}
.zlbl{background:var(--surf);border:1px solid var(--brd);font-size:.5rem;color:var(--dim);padding:0 .36rem;height:21px;display:flex;align-items:center;letter-spacing:.07em;min-width:46px;justify-content:center}
.zsep{width:1px;height:14px;background:var(--brd);margin:0 .08rem}
.cwrap{position:relative;background:var(--cbg);border:1px solid var(--brd);flex:1;min-height:0;overflow:hidden;transition:background .3s,border-color .3s}
.cwrap::before{content:'';position:absolute;inset:0;pointer-events:none;z-index:1;background:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:52px 52px}
canvas{position:absolute;top:0;left:0;width:100%;height:100%}
#iCv{z-index:2}#fCv{z-index:3;pointer-events:none}
.hint{position:absolute;bottom:.65rem;left:50%;transform:translateX(-50%);font-size:.48rem;color:var(--dim);letter-spacing:.16em;pointer-events:none;z-index:10;transition:opacity .8s;white-space:nowrap;opacity:0}
.cwrap.panning{cursor:grab}
.tring{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:18px;height:18px;border:2px solid var(--a3);border-radius:50%;pointer-events:none;z-index:15;display:none}
.tring.vis{display:block;animation:tpulse 1.5s infinite}
@keyframes tpulse{0%,100%{opacity:.7;transform:translate(-50%,-50%) scale(1)}50%{opacity:.3;transform:translate(-50%,-50%) scale(1.6)}}
.ibar{display:flex;gap:.2rem;flex-wrap:wrap;flex-shrink:0;padding:.15rem .46rem;background:transparent}
.chip{background:transparent;border:none;padding:.15rem .35rem;font-size:.54rem;color:var(--dim);letter-spacing:.05em}
.chip strong{color:var(--acc);font-weight:normal}
.seek-section{display:none}.seek-section.vis{display:block}

/* ═══ EQUATION MODAL — bigger, cleaner, working ═══ */
.eq-ov{position:fixed;inset:0;z-index:2000;overflow:auto;background:rgba(0,0,0,.82);display:none;padding:1rem}
[data-theme="light"] .eq-ov{background:rgba(0,0,0,.55)}
.eq-ov.vis{display:block}
.eq-box{max-width:860px;margin:0 auto;background:var(--surf);border:1px solid var(--brd);padding:1.6rem 1.8rem;position:relative}
.eq-box::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,var(--acc),transparent)}
.eq-x{position:absolute;top:.9rem;right:.9rem;background:transparent;border:1px solid var(--brd);color:var(--dim);width:28px;height:28px;cursor:pointer;font-size:.9rem;display:flex;align-items:center;justify-content:center;transition:all .15s}
.eq-x:hover{border-color:var(--acc);color:var(--acc)}
.eq-ttl{font-family:'Orbitron',sans-serif;font-size:.8rem;letter-spacing:.2em;color:var(--acc);margin-bottom:1.1rem}
.eq-tabs{display:flex;gap:4px;margin-bottom:1.1rem}
.eq-tb{flex:1;background:transparent;border:1px solid var(--brd);color:var(--dim);font-family:'Share Tech Mono',monospace;font-size:.78rem;padding:.42rem;cursor:pointer;text-align:center;letter-spacing:.08em;transition:all .15s;user-select:none}
.eq-tb:hover{border-color:var(--dim);color:var(--fg)}
.eq-tb.active{border-color:var(--acc);color:var(--acc);background:color-mix(in srgb,var(--acc) 12%,transparent)}
.eq-pane{display:none}.eq-pane.active{display:block}
.eq-code{font-family:'Share Tech Mono',monospace;font-size:.8rem;color:var(--fg);line-height:2;padding:1rem;background:var(--bg);border:1px solid var(--brd);margin-bottom:.75rem;overflow-x:auto;white-space:pre}
.eq-tbl-wrap{overflow:auto;max-height:300px;border:1px solid var(--brd)}
.eq-tbl{width:100%;border-collapse:collapse;font-size:.75rem}
.eq-tbl th{color:var(--acc);padding:.38rem .6rem;border-bottom:2px solid var(--brd);text-align:left;letter-spacing:.1em;font-weight:normal;position:sticky;top:0;background:var(--surf);z-index:1}
.eq-tbl td{padding:.32rem .6rem;border-bottom:1px solid color-mix(in srgb,var(--brd) 50%,transparent);color:var(--dim);font-size:.72rem}
.eq-tbl td:first-child{color:var(--fg)}
.eq-tbl tr:hover td{background:color-mix(in srgb,var(--acc) 5%,transparent)}
.spec-wrap{width:100%;height:240px;position:relative;border:1px solid var(--brd);background:var(--bg);margin-bottom:.6rem}
#specCv{width:100%;height:100%;display:block}
.spec-note{font-size:.68rem;color:var(--dim);text-align:center;line-height:1.6;margin-bottom:.4rem}
.exp-note{font-size:.72rem;color:var(--dim);margin-bottom:.6rem;line-height:1.6}
.exp-code{font-family:'Share Tech Mono',monospace;font-size:.64rem;color:var(--dim);background:var(--bg);border:1px solid var(--brd);padding:.7rem;white-space:pre-wrap;word-break:break-all;max-height:130px;overflow-y:auto;margin-bottom:.55rem;line-height:1.5}
.eq-cta{display:flex;gap:.5rem;margin-top:.6rem}
.cta-btn{flex:1;font-size:.68rem;padding:.42rem;letter-spacing:.1em;margin-bottom:0}
</style>
</head>
<body>
<div class="scanline"></div>
<div class="app" id="app">
  <div class="sidebar">
    <div class="panel-tab"><span class="ptd"></span>FOURIER DRAWING MACHINE</div>
    <div class="panel" style="border-top:none">
      <div class="pt">// Input Mode</div>
      <div class="tab-row t3">
        <button class="tb active" id="tdBtn" onclick="switchTab('draw')">✏ Draw</button>
        <button class="tb" id="tuBtn" onclick="switchTab('upload')">⬆ Image</button>
        <button class="tb" id="ttBtn" onclick="switchTab('text')">Aa Text</button>
      </div>
      <div id="tc-draw" class="tc active">
        <p style="font-size:.63rem;color:var(--dim);line-height:1.62;margin-bottom:.46rem">Freehand any path. Try to close the loop back to your start.</p>
        <button class="btn" onclick="clearAll()">⟳ Clear</button>
        <button class="btn pri" id="runD" onclick="startFourier()" disabled>▶ Run Fourier</button>
      </div>
      <div id="tc-upload" class="tc">
        <div class="uzone" id="uzone">
          <input type="file" id="fInput" accept="image/*,image/svg+xml" onchange="handleFile(event)">
          <p>⬆<br>PNG · JPG · SVG<br>drop or click</p>
        </div>
        <div class="ctrl" style="margin-top:.42rem">
          <label>Mode</label>
          <select id="extMode"><option value="lineart" selected>Line Art — trace strokes</option><option value="sil">Silhouette — outer boundary</option></select>
        </div>
        <div id="upSt" style="font-size:.58rem;color:var(--dim);min-height:.82em;letter-spacing:.05em"></div>
        <button class="btn pri" id="runU" onclick="startFourier()" disabled>▶ Run Fourier</button>
      </div>
      <div id="tc-text" class="tc">
        <input class="tinput" type="text" id="textIn" value="Hello" placeholder="Type text…">
        <select id="fontSel" onchange="updateFontPrev()">
          <option value="'Dancing Script',cursive">Dancing Script ✦</option>
          <option value="'Great Vibes',cursive">Great Vibes ✦</option>
          <option value="Satisfy,cursive">Satisfy ✦</option>
          <option value="Pacifico,cursive">Pacifico ✦</option>
          <option value="Caveat,cursive" selected>Caveat ✦</option>
          <option value="Sacramento,cursive">Sacramento ✦</option>
          <option value="'Alex Brush',cursive">Alex Brush ✦</option>
          <option value="Lobster,cursive">Lobster ✦</option>
          <option value="Courgette,cursive">Courgette ✦</option>
          <option value="Cookie,cursive">Cookie ✦</option>
          <option value="Yellowtail,cursive">Yellowtail ✦</option>
          <option value="'Kaushan Script',cursive">Kaushan Script ✦</option>
          <option value="'Permanent Marker',cursive">Permanent Marker ✦</option>
          <option value="'Indie Flower',cursive">Indie Flower ✦</option>
          <option value="Georgia,serif">Georgia (serif)</option>
          <option value="Impact,sans-serif">Impact (bold)</option>
          <option value="'Courier New',monospace">Courier (mono)</option>
          <option value="Arial,sans-serif">Arial (sans)</option>
          <option value="'Orbitron',sans-serif">Orbitron (geo)</option>
        </select>
        <div class="font-prev" id="fontPrev">Caveat</div>
        <div class="ctrl">
          <label>Font Size <span id="vFS">220</span>px <span id="vFSa" style="font-size:.55rem;color:var(--dim)"></span></label>
          <input type="range" id="sFS" min="60" max="500" value="220" oninput="document.getElementById('vFS').textContent=this.value;document.getElementById('vFSa').textContent=''">
        </div>
        <div class="ctrl" style="margin-bottom:.38rem">
          <label>Render as</label>
          <select id="renderMode" style="margin-bottom:0">
            <option value="fill">Filled — crisp outlines</option>
            <option value="stroke" selected>Stroke — continuous lines ✦</option>
          </select>
        </div>
        <button class="btn" onclick="processText()" style="margin-top:.1rem">→ Convert to Path</button>
        <button class="btn pri" id="runT" onclick="startFourier()" disabled>▶ Run Fourier</button>
      </div>
    </div>
    <div class="pg"></div>
    <div class="panel">
      <div class="pt">// Parameters</div>
      <div class="ctrl"><label>Epicycles <span id="vE">200</span></label>
        <input type="range" id="sE" min="1" max="4096" value="200" oninput="document.getElementById('vE').textContent=this.value"></div>
      <div class="ctrl"><label>FFT Resolution <span id="vFR">1024 pts</span></label>
        <input type="range" id="sFR" min="0" max="3" step="1" value="1" oninput="onFftRes()"></div>
      <div class="ctrl"><label>Speed <span id="vSp">1.00×</span></label>
        <input type="range" id="sSp" min="0" max="100" value="80" oninput="syncSpd()"></div>
      <div class="ctrl">
        <label>Trail Length <span id="vTl">18000</span>
          <button class="lbl-btn" onclick="autoTrail()" title="Auto-set for ~1 full cycle">AUTO</button>
        </label>
        <input type="range" id="sTl" min="100" max="100000" step="100" value="18000" oninput="document.getElementById('vTl').textContent=this.value"></div>
      <div class="ctrl"><label>Min Radius <span id="vMn">0.5px</span></label>
        <input type="range" id="sMn" min="1" max="80" value="5" oninput="document.getElementById('vMn').textContent=(this.value/10).toFixed(1)+'px'"></div>
    </div>
    <div class="pg"></div>
    <div class="panel">
      <div class="pt">// Visuals</div>
      <div class="crow"><label>CIRCLES</label><input type="color" id="cC" value="#1c3878"></div>
      <div class="crow"><label>ARROWS</label> <input type="color" id="cA" value="#7a4c14"></div>
      <div class="crow"><label>TRAIL</label>  <input type="color" id="cT" value="#78122a"></div>
      <div class="ctrl" style="margin-top:.36rem"><label>Circle Opacity <span id="vCO">28%</span></label>
        <input type="range" id="sCO" min="3" max="95" value="28" oninput="document.getElementById('vCO').textContent=this.value+'%'"></div>
      <div class="ctrl"><label>Circle Stroke <span id="vCS">0.7</span></label>
        <input type="range" id="sCS" min="2" max="50" value="7" oninput="document.getElementById('vCS').textContent=(this.value/10).toFixed(1)"></div>
      <div class="ctrl"><label>Arrow/Trail Weight <span id="vLW">1.2</span></label>
        <input type="range" id="sLW" min="3" max="45" value="12" oninput="document.getElementById('vLW').textContent=(this.value/10).toFixed(1)"></div>
      <div class="trow"><span>Circles</span><label class="pill"><input type="checkbox" id="tSC" checked><div class="pill-tr"></div><div class="pill-dt"></div></label></div>
      <div class="trow"><span>Arrows</span><label class="pill"><input type="checkbox" id="tSA" checked><div class="pill-tr"></div><div class="pill-dt"></div></label></div>
      <div class="trow"><span>Trail Fade</span><label class="pill"><input type="checkbox" id="tTF" checked><div class="pill-tr"></div><div class="pill-dt"></div></label></div>
